# STAGE 1893 - ACME-only bootstrap virtual host for stage41.bms24.online.
# TEMPLATE - NEVER enable before inspecting current Nginx config and DNS.
# No backend proxy; never serves unsupported Moodle over cleartext.
server {
    listen 80;
    server_name stage41.bms24.online;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 404;
    }
}
