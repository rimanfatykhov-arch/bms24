# BMS24 parity41 — EXAMPLE ONLY; do not place in sites-enabled before
# DNS, certificate, htpasswd file and backend are verified.
# This virtual host is separate from existing test.bms24.online.
server {
    listen 80;
    server_name stage41.bms24.online;

    # Provision separate ACME webroot first, if using certbot --webroot.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        auth_basic off;
        try_files $uri =404;
    }
    location / {
        return 308 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name stage41.bms24.online;

    ssl_certificate /etc/letsencrypt/live/stage41.bms24.online/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/stage41.bms24.online/privkey.pem;

    # Mandatory external authentication while Moodle 4.1 remains unsupported.
    # File must be generated on the Timeweb VDS, never committed to Git.
    auth_basic "BMS24 private parity test";
    auth_basic_user_file /etc/nginx/private/bms24-stage41.htpasswd;

    client_max_body_size 72m;
    proxy_read_timeout 180s;
    location / {
        proxy_pass http://127.0.0.1:18081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
