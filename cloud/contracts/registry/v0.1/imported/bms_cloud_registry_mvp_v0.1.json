  "relationships": [
    {
      "from": "CloudCustomer",
      "to": "CloudWorkspace",
      "cardinality": "1:N",
      "via": "CloudWorkspace.customer_uuid"
    },
    {
      "from": "CloudWorkspace",
      "to": "WorkspaceCompanyLink",
      "cardinality": "1:N",
      "via": "WorkspaceCompanyLink.workspace_uuid"
    },
    {
      "from": "WorkspaceCompanyLink",
      "to": "BMS Company (external)",
      "cardinality": "N:1",
      "via": "company_uuid"
    },
    {
      "from": "CloudWorkspace",
      "to": "SubscriptionReference",
      "cardinality": "1:N",
      "via": "SubscriptionReference.workspace_uuid"
    },
    {
      "from": "CloudWorkspace",
      "to": "EntitlementAssignment",
      "cardinality": "1:N",
      "via": "EntitlementAssignment.workspace_uuid"
    },
    {
      "from": "CloudWorkspace",
      "to": "ApplicationInstance",
      "cardinality": "1:N for isolated apps; shared apps may be global",
      "via": "ApplicationInstance.workspace_uuid"
    },
    {
      "from": "CloudWorkspace",
      "to": "IntegrationConnection",
      "cardinality": "1:N",
      "via": "IntegrationConnection.workspace_uuid"
    },
    {
      "from": "CloudWorkspace",
      "to": "ProvisioningJob",
      "cardinality": "1:N",
      "via": "ProvisioningJob.workspace_uuid"
    },
    {
      "from": "CloudWorkspace",
      "to": "AuditEvent",
      "cardinality": "1:N optional",
      "via": "AuditEvent.workspace_uuid"
    }
  ],
  "invariants": [
    "workspace_uuid is immutable",
    "CloudCustomer and BMS Company are different entities",
    "CloudWorkspace and BMS Company are linked only through WorkspaceCompanyLink in canonical relations",
    "v0.1 allows exactly one active Primary WorkspaceCompanyLink per Workspace",
    "No raw secrets are stored in Registry",
    "All Control Plane mutations create AuditEvent records",
    "Repeated commercial/provisioning triggers must be idempotent",
    "Closed Workspace cannot create a new ProvisioningJob until explicitly reactivated",
    "Shared Moodle runtime is not provisioned per customer; access is represented by entitlement + shared application availability",
    "ERP ApplicationInstance requires workspace_uuid and a BMS Company link before activation",
    "Human-readable slug/display_name/provider IDs are not canonical identity",
    "Lifecycle suspension/closure must not cascade-delete BMS Company or historical Registry records"
  ]
}