{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bms24.invalid/cloud/contracts/registry/v0.1/exchange.schema.json",
  "title": "BMS Cloud Registry MVP exchange payload v0.1 (PROPOSED, authored for CLOUD-1a)",
  "description": "Structural contract for registry exchange payloads. Semantic invariants are enforced by cloud/tools/cloud_contracts.py. Enum values must equal registry_mvp.json enums named by x-bms-enum.",
  "type": "object",
  "additionalProperties": false,
  "required": ["payload_version", "as_of", "state"],
  "properties": {
    "payload_version": {"const": "bms24.cloud.exchange/0.1"},
    "as_of": {"$ref": "#/$defs/timestamp"},
    "state": {"$ref": "#/$defs/state"},
    "commercial_events": {"type": "array", "items": {"$ref": "#/$defs/commercial_event"}},
    "mutations": {"type": "array", "items": {"$ref": "#/$defs/mutation"}},
    "moodle_projections": {"type": "array", "items": {"$ref": "#/$defs/moodle_projection"}},
    "entitlement_snapshots": {"type": "array", "items": {"$ref": "#/$defs/entitlement_snapshot"}}
  },
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "code": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"},
    "bundle": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "text": {"type": "string", "minLength": 1},
    "metadata": {"type": "object"},
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["customers", "workspaces", "company_links", "subscriptions", "entitlement_assignments", "application_instances", "integration_connections", "provisioning_jobs", "audit_events"],
      "properties": {
        "customers": {"type": "array", "items": {"$ref": "#/$defs/customer"}},
        "workspaces": {"type": "array", "items": {"$ref": "#/$defs/workspace"}},
        "company_links": {"type": "array", "items": {"$ref": "#/$defs/company_link"}},
        "subscriptions": {"type": "array", "items": {"$ref": "#/$defs/subscription"}},
        "entitlement_assignments": {"type": "array", "items": {"$ref": "#/$defs/entitlement_assignment"}},
        "application_instances": {"type": "array", "items": {"$ref": "#/$defs/application_instance"}},
        "integration_connections": {"type": "array", "items": {"$ref": "#/$defs/integration_connection"}},
        "provisioning_jobs": {"type": "array", "items": {"$ref": "#/$defs/provisioning_job"}},
        "audit_events": {"type": "array", "items": {"$ref": "#/$defs/audit_event"}}
      }
    },
    "customer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["customer_uuid", "commercial_provider", "commercial_customer_id", "display_name", "status", "created_at"],
      "properties": {
        "customer_uuid": {"$ref": "#/$defs/uuid"},
        "commercial_provider": {"enum": ["odoo_corporate", "manual_beta"], "x-bms-enum": "commercial_provider"},
        "commercial_customer_id": {"$ref": "#/$defs/text"},
        "display_name": {"$ref": "#/$defs/text"},
        "status": {"$ref": "#/$defs/text"},
        "created_at": {"$ref": "#/$defs/timestamp"},
        "metadata": {"$ref": "#/$defs/metadata"}
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace_uuid", "customer_uuid", "slug", "display_name", "status", "release_channel", "created_at"],
      "properties": {
        "workspace_uuid": {"$ref": "#/$defs/uuid"},
        "customer_uuid": {"$ref": "#/$defs/uuid"},
        "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
        "display_name": {"$ref": "#/$defs/text"},
        "status": {"enum": ["draft", "provisioning", "active", "degraded", "suspended", "closing", "closed"], "x-bms-enum": "workspace_status"},
        "release_channel": {"enum": ["stable", "early_access", "development"], "x-bms-enum": "release_channel"},
        "created_at": {"$ref": "#/$defs/timestamp"},
        "activated_at": {"$ref": "#/$defs/timestamp"},
        "suspended_at": {"$ref": "#/$defs/timestamp"},
        "closed_at": {"$ref": "#/$defs/timestamp"},
        "reactivated_at": {"$ref": "#/$defs/timestamp"},
        "metadata": {"$ref": "#/$defs/metadata"}
      }
    },
    "company_link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["link_uuid", "workspace_uuid", "company_uuid", "role", "status", "effective_from"],
      "properties": {
        "link_uuid": {"$ref": "#/$defs/uuid"},
        "workspace_uuid": {"$ref": "#/$defs/uuid"},
        "company_uuid": {"$ref": "#/$defs/uuid"},
        "role": {"enum": ["primary", "subsidiary", "holding_member", "sandbox_test"], "x-bms-enum": "company_link_role"},
        "status": {"enum": ["active", "ended"], "x-bms-enum": "company_link_status"},
        "effective_from": {"$ref": "#/$defs/timestamp"},
        "effective_to": {"$ref": "#/$defs/timestamp"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "recorded_by", "recorded_at", "evidence_ref", "audit_uuid"],
      "properties": {
        "source_type": {"enum": ["manual_registration", "commercial_sync"], "x-bms-enum": "subscription_source_type"},
        "recorded_by": {"$ref": "#/$defs/text"},
        "recorded_at": {"$ref": "#/$defs/timestamp"},
        "evidence_ref": {"$ref": "#/$defs/text"},
        "audit_uuid": {"$ref": "#/$defs/uuid"}
      }
    },
    "subscription": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subscription_ref_uuid", "workspace_uuid", "commercial_provider", "subscription_id", "bundle_code", "commercial_status", "effective_from", "source_revision"],
      "properties": {
        "subscription_ref_uuid": {"$ref": "#/$defs/uuid"},
        "workspace_uuid": {"$ref": "#/$defs/uuid"},
        "commercial_provider": {"enum": ["odoo_corporate", "manual_beta"], "x-bms-enum": "commercial_provider"},
        "subscription_id": {"$ref": "#/$defs/text"},
        "bundle_code": {"$ref": "#/$defs/bundle"},
        "commercial_status": {"enum": ["active", "suspended", "cancelled", "expired"], "x-bms-enum": "subscription_commercial_status"},
        "effective_from": {"$ref": "#/$defs/timestamp"},
        "effective_to": {"$ref": "#/$defs/timestamp"},
        "last_synced_at": {"$ref": "#/$defs/timestamp"},
        "source_revision": {"$ref": "#/$defs/text"},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "entitlement_assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assignment_uuid", "workspace_uuid", "state", "source_type", "source_reference", "effective_from", "revision"],
      "properties": {
        "assignment_uuid": {"$ref": "#/$defs/uuid"},
        "workspace_uuid": {"$ref": "#/$defs/uuid"},
        "entitlement_code": {"$ref": "#/$defs/code"},
        "bundle_code": {"$ref": "#/$defs/bundle"},
        "state": {"enum": ["pending", "enabled", "suspended", "expired", "revoked"], "x-bms-enum": "entitlement_assignment_state"},
        "source_type": {"enum": ["commercial_subscription", "commercial_order", "manual_admin_grant", "pilot", "trial", "internal_demo", "migration", "support_override"], "x-bms-enum": "assignment_source_type"},
        "source_reference": {"$ref": "#/$defs/text"},
        "effective_from": {"$ref": "#/$defs/timestamp"},
        "effective_to": {"$ref": "#/$defs/timestamp"},
        "value": {"type": ["integer", "string"]},
        "reason": {"$ref": "#/$defs/text"},
        "revision": {"type": "integer"}
      }
    },
    "application_instance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instance_uuid", "application_code", "isolation", "workspace_uuid", "provider_type", "provider_environment_id", "state", "release_channel", "created_at"],
      "properties": {
        "instance_uuid": {"$ref": "#/$defs/uuid"},
        "application_code": {"enum": ["mgmt", "academy", "cloud", "erp", "int", "api"], "x-bms-enum": "application_code"},
        "isolation": {"enum": ["shared", "isolated"], "x-bms-enum": "isolation"},
        "workspace_uuid": {"type": ["string", "null"], "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
        "company_uuid": {"$ref": "#/$defs/uuid"},
        "provider_type": {"$ref": "#/$defs/text"},
        "provider_environment_id": {"$ref": "#/$defs/text"},
        "state": {"enum": ["draft", "provisioning", "ready", "active", "degraded", "maintenance", "suspended", "failed", "retiring", "retired"], "x-bms-enum": "application_instance_state"},
        "release_channel": {"enum": ["stable", "early_access", "development"], "x-bms-enum": "release_channel"},
        "created_at": {"$ref": "#/$defs/timestamp"},
        "metadata": {"$ref": "#/$defs/metadata"}
      }
    },
    "integration_connection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connection_uuid", "workspace_uuid", "company_uuid", "provider_type", "provider_environment", "purpose", "state", "contract_version", "credential_reference"],
      "properties": {
        "connection_uuid": {"$ref": "#/$defs/uuid"},
        "workspace_uuid": {"$ref": "#/$defs/uuid"},
        "company_uuid": {"$ref": "#/$defs/uuid"},
        "provider_type": {"$ref": "#/$defs/text"},
        "provider_environment": {"$ref": "#/$defs/text"},
        "purpose": {"$ref": "#/$defs/text"},
        "state": {"enum": ["provisioning", "healthy", "degraded", "failed", "blocked", "suspended", "closed"], "x-bms-enum": "integration_connection_state"},
        "contract_version": {"$ref": "#/$defs/text"},
        "credential_reference": {"type": "string", "pattern": "^secretref://[a-z0-9][a-z0-9/_.-]*$"},
        "metadata": {"$ref": "#/$defs/metadata"}
      }
    },
    "provisioning_job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["job_uuid", "workspace_uuid", "target_type", "target_id", "operation", "handler", "idempotency_key", "request_hash", "state", "attempt_count", "requested_by", "correlation_id", "created_at"],
      "properties": {
        "job_uuid": {"$ref": "#/$defs/uuid"},
        "workspace_uuid": {"$ref": "#/$defs/uuid"},
        "target_type": {"enum": ["workspace", "application_instance", "integration_connection"]},
        "target_id": {"$ref": "#/$defs/uuid"},
        "operation": {"$ref": "#/$defs/text"},
        "handler": {"$ref": "#/$defs/text"},
        "idempotency_key": {"$ref": "#/$defs/text"},
        "request_hash": {"$ref": "#/$defs/sha256"},
        "state": {"enum": ["queued", "running", "waiting_external", "retry_scheduled", "succeeded", "failed", "blocked", "cancelled", "rollback"], "x-bms-enum": "provisioning_job_state"},
        "attempt_count": {"type": "integer"},
        "requested_by": {"$ref": "#/$defs/text"},
        "correlation_id": {"$ref": "#/$defs/text"},
        "created_at": {"$ref": "#/$defs/timestamp"},
        "last_error": {"type": "string"}
      }
    },
    "audit_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audit_uuid", "actor_type", "actor_id", "action", "target_type", "target_id", "occurred_at", "correlation_id"],
      "properties": {
        "audit_uuid": {"$ref": "#/$defs/uuid"},
        "workspace_uuid": {"$ref": "#/$defs/uuid"},
        "actor_type": {"enum": ["user", "operator", "service", "system"], "x-bms-enum": "actor_type"},
        "actor_id": {"$ref": "#/$defs/text"},
        "action": {"$ref": "#/$defs/code"},
        "target_type": {"$ref": "#/$defs/text"},
        "target_id": {"$ref": "#/$defs/uuid"},
        "occurred_at": {"$ref": "#/$defs/timestamp"},
        "correlation_id": {"$ref": "#/$defs/text"},
        "reason": {"type": "string"}
      }
    },
    "commercial_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delivery_id", "source_system", "event_id", "workspace_uuid", "operation", "idempotency_key", "request_hash", "result_type", "result_uuid"],
      "properties": {
        "delivery_id": {"$ref": "#/$defs/text"},
        "source_system": {"enum": ["odoo_corporate", "manual_beta"], "x-bms-enum": "commercial_provider"},
        "event_id": {"$ref": "#/$defs/text"},
        "workspace_uuid": {"$ref": "#/$defs/uuid"},
        "operation": {"$ref": "#/$defs/text"},
        "idempotency_key": {"$ref": "#/$defs/text"},
        "request_hash": {"$ref": "#/$defs/sha256"},
        "result_type": {"enum": ["provisioning_job", "subscription", "workspace"]},
        "result_uuid": {"$ref": "#/$defs/uuid"}
      }
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "entity", "id"],
      "properties": {
        "op": {"enum": ["update", "delete"], "x-bms-enum": "mutation_op"},
        "entity": {"enum": ["customer", "workspace", "company_link", "subscription", "entitlement_assignment", "application_instance", "integration_connection", "provisioning_job", "audit_event"]},
        "id": {"$ref": "#/$defs/uuid"},
        "set": {"type": "object"}
      }
    },
    "moodle_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["company_uuid", "workspace_uuid", "runtime_instance_uuid", "cloud_status", "entitlement_mode", "erp_application_state", "integration_health"],
      "properties": {
        "company_uuid": {"$ref": "#/$defs/uuid"},
        "workspace_uuid": {"$ref": "#/$defs/uuid"},
        "runtime_instance_uuid": {"$ref": "#/$defs/uuid"},
        "projection_revision": {"type": "integer"},
        "cloud_status": {"enum": ["pending", "active", "degraded", "suspended", "closed", "error"], "x-moodle-enum": "cloud_status"},
        "entitlement_mode": {"enum": ["legacy_compatibility", "cloud_snapshot", "suspended"], "x-moodle-enum": "entitlement_mode"},
        "erp_application_state": {"enum": ["not_provisioned", "provisioning", "ready", "active", "degraded", "suspended", "failed", "retired"], "x-moodle-enum": "erp_application_state"},
        "integration_health": {"enum": ["unknown", "healthy", "degraded", "failed", "blocked", "suspended", "closed"], "x-moodle-enum": "integration_health"}
      }
    },
    "entitlement_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace_uuid", "company_uuid", "snapshot_revision", "catalog_version", "codes"],
      "properties": {
        "workspace_uuid": {"$ref": "#/$defs/uuid"},
        "company_uuid": {"$ref": "#/$defs/uuid"},
        "snapshot_revision": {"$ref": "#/$defs/text"},
        "catalog_version": {"$ref": "#/$defs/text"},
        "codes": {"type": "array", "items": {"$ref": "#/$defs/code"}}
      }
    }
  }
}
