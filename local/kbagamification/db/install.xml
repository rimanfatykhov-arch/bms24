      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" />
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" />
        <FIELD NAME="description" TYPE="text" NOTNULL="false" SEQUENCE="false" />
        <FIELD NAME="icon" TYPE="char" LENGTH="100" NOTNULL="true" DEFAULT="trophy" SEQUENCE="false" />
        <FIELD NAME="rarity" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="common" SEQUENCE="false" />
        <FIELD NAME="conditiontype" TYPE="char" LENGTH="50" NOTNULL="true" SEQUENCE="false" />
