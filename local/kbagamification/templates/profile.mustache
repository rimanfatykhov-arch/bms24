<div class="local-kbagamification-profile">
    {{#navigation}}{{> local_kbagamification/user_nav }}{{/navigation}}
    <section class="kba-profile-hero card mb-4">
        <div class="card-body">
            <div class="d-flex flex-wrap align-items-center">
                <img class="kba-profile-avatar mr-3 mb-3 mb-md-0" src="{{userpicture}}" alt="{{fullname}}">
                <div class="flex-grow-1 mr-md-4">
                    <div class="text-muted text-uppercase small font-weight-bold">{{#str}}learningprofile, local_kbagamification{{/str}}</div>
                    <h2 class="mb-1">{{fullname}}</h2>
                    <div class="h4 mb-2">{{#str}}currentlevel, local_kbagamification{{/str}}: <strong>{{levelname}}</strong></div>
                    {{#showlevelprogress}}
                        {{#hasnextlevel}}
                            <div class="d-flex justify-content-between small mb-1">
                                <span>{{levelname}}</span>
                                <span>{{progress}}%</span>
                                <span>{{nextlevelname}} — {{nextlevelxp}} XP</span>
                            </div>
                            <div class="progress kba-profile-progress" aria-label="{{#str}}levelprogress, local_kbagamification{{/str}}">
                                <div class="progress-bar" role="progressbar" style="width: {{progress}}%;" aria-valuenow="{{progress}}" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                            <div class="small text-muted mt-1">{{xptogo}} {{#str}}xptogo, local_kbagamification{{/str}}</div>
                        {{/hasnextlevel}}
                        {{^hasnextlevel}}
                            <div class="small text-muted">{{#str}}maxlevelreached, local_kbagamification{{/str}}</div>
                        {{/hasnextlevel}}
                    {{/showlevelprogress}}
                </div>
                <div class="kba-profile-stat-grid mt-3 mt-lg-0">
                    <div class="kba-profile-stat">
                        <div class="kba-profile-stat-value">{{xp}}</div>
                        <div class="kba-profile-stat-label">KBA XP</div>
                    </div>
                    {{#showcoins}}
                    <div class="kba-profile-stat">
                        <div class="kba-profile-stat-value">{{coins}}</div>
                        <div class="kba-profile-stat-label">{{#str}}coins, local_kbagamification{{/str}}</div>
                    </div>
                    {{/showcoins}}
                    <div class="kba-profile-stat">
                        <div class="kba-profile-stat-value">{{achievementcount}}</div>
                        <div class="kba-profile-stat-label">{{#str}}achievements, local_kbagamification{{/str}}</div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {{#canaward}}
    <div class="kba-profile-admin-tools mb-4">
        <div class="small text-uppercase text-muted font-weight-bold mb-2">{{#str}}admintools, local_kbagamification{{/str}}</div>
        <div class="d-flex flex-wrap">
            <a href="{{awardurl}}" class="btn btn-outline-secondary mr-2 mb-2">{{#str}}manualaward, local_kbagamification{{/str}}</a>
            {{#canawardachievement}}
                <a href="{{achievementawardurl}}" class="btn btn-outline-secondary mb-2">{{#str}}awardachievement, local_kbagamification{{/str}}</a>
            {{/canawardachievement}}
        </div>
    </div>
    {{/canaward}}
    {{^canaward}}
        {{#canawardachievement}}
        <div class="kba-profile-admin-tools mb-4">
            <div class="small text-uppercase text-muted font-weight-bold mb-2">{{#str}}admintools, local_kbagamification{{/str}}</div>
            <a href="{{achievementawardurl}}" class="btn btn-outline-secondary mb-2">{{#str}}awardachievement, local_kbagamification{{/str}}</a>
        </div>
        {{/canawardachievement}}
    {{/canaward}}

    <div class="row">
        <div class="col-lg-7">
            <section class="mb-4" id="kba-achievements">
                <div class="d-flex justify-content-between align-items-end mb-3">
                    <div>
                        <div class="text-muted small text-uppercase font-weight-bold">{{#str}}achievementgallery, local_kbagamification{{/str}}</div>
                        <h3 class="mb-0">{{#str}}achievements, local_kbagamification{{/str}}</h3>
                    </div>
                    <span class="badge badge-light p-2">{{achievementcount}} / {{achievementtotal}}</span>
                </div>

                {{#hasachievements}}
                <div class="row">
                    {{#achievements}}
                    <div class="col-md-6 mb-3">
                        <article class="card h-100 kba-achievement-card kba-rarity-{{rarity}} {{#locked}}kba-achievement-locked{{/locked}}">
                            <div class="card-body">
                                <div class="d-flex align-items-start">
                                    <div class="kba-achievement-icon mr-3" aria-hidden="true">{{icon}}</div>
                                    <div class="flex-grow-1">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <h4 class="h5 mb-1">{{name}}</h4>
                                            <span class="badge badge-light">{{raritylabel}}</span>
                                        </div>
                                        <div class="text-muted small mb-2">{{{description}}}</div>
                                        {{#awarded}}
                                            <div class="small font-weight-bold kba-achievement-earned">{{#str}}achievementearned, local_kbagamification{{/str}} — {{date}}</div>
                                        {{/awarded}}
                                        {{#locked}}
                                            <div class="d-flex justify-content-between small mb-1">
                                                <span>{{current}} / {{target}}</span>
                                                <span>{{progress}}%</span>
                                            </div>
                                            <div class="progress kba-achievement-progress">
                                                <div class="progress-bar" role="progressbar" style="width: {{progress}}%;" aria-valuenow="{{progress}}" aria-valuemin="0" aria-valuemax="100"></div>
                                            </div>
                                        {{/locked}}
                                        {{#hasreward}}
                                            <div class="small text-muted mt-2">{{#str}}achievementreward, local_kbagamification{{/str}}: +{{rewardxp}} XP{{#showcoins}} / +{{rewardcoins}} {{#str}}coins, local_kbagamification{{/str}}{{/showcoins}}</div>
                                        {{/hasreward}}
                                    </div>
                                </div>
                            </div>
                        </article>
                    </div>
                    {{/achievements}}
                </div>
                {{/hasachievements}}
                {{^hasachievements}}
                    <div class="alert alert-light border">{{#str}}noachievementsconfigured, local_kbagamification{{/str}}</div>
                {{/hasachievements}}
            </section>
        </div>

        <div class="col-lg-5">
            {{#hasnextgoals}}
            <section class="card mb-4 kba-goals-card">
                <div class="card-body">
                    <div class="text-muted small text-uppercase font-weight-bold">{{#str}}nextgoals, local_kbagamification{{/str}}</div>
                    <h3 class="h4">{{#str}}nextgoalsheading, local_kbagamification{{/str}}</h3>
                    {{#nextgoals}}
                        <div class="kba-goal-item py-3">
                            <div class="d-flex align-items-start">
                                <div class="kba-goal-icon mr-3" aria-hidden="true">{{icon}}</div>
                                <div class="flex-grow-1">
                                    <div class="d-flex justify-content-between">
                                        <strong>{{name}}</strong>
                                        <span class="small text-muted">{{progress}}%</span>
                                    </div>
                                    <div class="small text-muted mb-2">{{current}} / {{target}}</div>
                                    <div class="progress kba-achievement-progress">
                                        <div class="progress-bar" role="progressbar" style="width: {{progress}}%;" aria-valuenow="{{progress}}" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {{/nextgoals}}
                </div>
            </section>
            {{/hasnextgoals}}

            {{#hasrecentearned}}
            <section class="card mb-4">
                <div class="card-body">
                    <div class="text-muted small text-uppercase font-weight-bold">{{#str}}recentachievements, local_kbagamification{{/str}}</div>
                    <h3 class="h4">{{#str}}recentachievementsheading, local_kbagamification{{/str}}</h3>
                    {{#recentearned}}
                        <div class="d-flex align-items-start py-2 kba-recent-achievement">
                            <div class="kba-goal-icon mr-3" aria-hidden="true">{{icon}}</div>
                            <div>
                                <strong>{{name}}</strong>
                                <div class="small text-muted">{{date}}</div>
                            </div>
                        </div>
                    {{/recentearned}}
                </div>
            </section>
            {{/hasrecentearned}}
        </div>
    </div>

    {{#showhistory}}
    <section class="mb-4" id="kba-activity">
        <div class="text-muted small text-uppercase font-weight-bold">{{#str}}activitytimeline, local_kbagamification{{/str}}</div>
        <h3>{{#str}}recenttransactions, local_kbagamification{{/str}}</h3>
        {{#hastransactions}}
            <div class="kba-activity-timeline">
                {{#transactions}}
                    <div class="kba-activity-item {{#positive}}kba-activity-positive{{/positive}} {{#negative}}kba-activity-negative{{/negative}}">
                        <div class="kba-activity-amount">{{amount}} {{currency}}</div>
                        <div class="kba-activity-reason">{{{reason}}}</div>
                        <div class="small text-muted">{{date}} · {{#str}}balanceafter, local_kbagamification{{/str}}: {{balance}}</div>
                    </div>
                {{/transactions}}
            </div>
        {{/hastransactions}}
        {{^hastransactions}}
            <div class="alert alert-light border">{{#str}}notransactions, local_kbagamification{{/str}}</div>
        {{/hastransactions}}
    </section>
    {{/showhistory}}
</div>
