<div class="kba-reward-store">
    <div class="kba-store-toolbar">
        <div>
            <h2>{{#str}}rewardstore, local_kbagamification{{/str}}</h2>
            <p>{{#str}}rewardstoreintro, local_kbagamification{{/str}}</p>
        </div>
        <div class="kba-store-balance">
            <span>{{#str}}yourbalance, local_kbagamification{{/str}}</span>
            <strong>{{coins}} {{#str}}coins, local_kbagamification{{/str}}</strong>
            <a class="btn btn-secondary btn-sm" href="{{ordersurl}}">{{#str}}myrewardorders, local_kbagamification{{/str}}</a>
        </div>
    </div>

    {{^hasitems}}
        <div class="alert alert-info">{{#str}}norewardsavailable, local_kbagamification{{/str}}</div>
    {{/hasitems}}

    {{#hasitems}}
    <div class="kba-reward-grid">
        {{#items}}
        <div class="kba-reward-card">
            <div class="kba-reward-icon">{{icon}}</div>
            <div class="kba-reward-type">{{type}}</div>
            <h3>{{name}}</h3>
            <p class="kba-reward-description">{{description}}</p>
            <div class="kba-reward-meta">
                <div><strong>{{cost}} {{#str}}coins, local_kbagamification{{/str}}</strong></div>
                <div>{{#str}}rewardstockshort, local_kbagamification{{/str}}: {{stocklabel}}</div>
                {{#haslevel}}<div>{{#str}}rewardlevelshort, local_kbagamification{{/str}}: {{levelname}}</div>{{/haslevel}}
            </div>
            {{#allowed}}
                <a class="btn btn-primary" href="{{url}}">{{#str}}getreward, local_kbagamification{{/str}}</a>
            {{/allowed}}
            {{^allowed}}
                <button class="btn btn-secondary" type="button" disabled>{{blockedreason}}</button>
            {{/allowed}}
        </div>
        {{/items}}
    </div>
    {{/hasitems}}
</div>
