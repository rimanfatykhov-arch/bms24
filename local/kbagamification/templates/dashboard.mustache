<div class="mb-3">{{#canviewstore}}<a class="btn btn-primary mr-2" href="{{storeurl}}">🎁 {{#str}}rewardstore, local_kbagamification{{/str}}</a> <a class="btn btn-outline-secondary" href="{{ordersurl}}">{{#str}}myrewardorders, local_kbagamification{{/str}}</a>{{/canviewstore}}</div>
<div class="local-kbagamification-dashboard">
    <div class="row mb-4">
        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted">{{#str}}xp, local_kbagamification{{/str}}</div>
                    <div class="display-4 font-weight-bold">{{xp}}</div>
                    <div>{{#str}}experiencehint, local_kbagamification{{/str}}</div>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted">{{#str}}coins, local_kbagamification{{/str}}</div>
                    <div class="display-4 font-weight-bold">{{coins}}</div>
                    <div>{{#str}}coinshint, local_kbagamification{{/str}}</div>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted">{{#str}}currentlevel, local_kbagamification{{/str}}</div>
                    <div class="h2 font-weight-bold">{{levelname}}</div>
                    {{#hasnextlevel}}
                        <div>{{#str}}nextlevel, local_kbagamification{{/str}}: {{nextlevelname}}</div>
                        <div class="small text-muted">{{xptogo}} {{#str}}xptogo, local_kbagamification{{/str}}</div>
                    {{/hasnextlevel}}
                </div>
            </div>
        </div>
    </div>

    {{#hasnextlevel}}
    <div class="mb-4">
        <div class="d-flex justify-content-between mb-1">
            <strong>{{levelname}}</strong>
            <span>{{progress}}%</span>
            <strong>{{nextlevelname}} — {{nextlevelxp}} XP</strong>
        </div>
        <div class="progress" style="height: 18px;">
            <div class="progress-bar" role="progressbar" style="width: {{progress}}%;" aria-valuenow="{{progress}}" aria-valuemin="0" aria-valuemax="100"></div>
        </div>
    </div>
    {{/hasnextlevel}}

    <div class="d-flex flex-wrap mb-4">
        {{#canaward}}
            <a href="{{awardurl}}" class="btn btn-primary mr-2 mb-2">{{#str}}manualaward, local_kbagamification{{/str}}</a>
        {{/canaward}}
        {{#canawardachievement}}
            <a href="{{achievementawardurl}}" class="btn btn-secondary mb-2">{{#str}}awardachievement, local_kbagamification{{/str}}</a>
        {{/canawardachievement}}
        {{#canviewleaderboards}}
            <a href="{{leaderboardurl}}" class="btn btn-outline-primary ml-2 mb-2">🏆 {{#str}}leaderboards, local_kbagamification{{/str}}</a>
        {{/canviewleaderboards}}
    </div>

    <div class="d-flex justify-content-between align-items-end mb-3">
        <h3 class="mb-0">{{#str}}achievements, local_kbagamification{{/str}}</h3>
        <span class="text-muted">{{achievementcount}} / {{achievementtotal}}</span>
    </div>

    {{#hasachievements}}
    <div class="row mb-4">
        {{#achievements}}
        <div class="col-md-6 col-lg-4 mb-3">
            <div class="card h-100 kba-achievement-card kba-rarity-{{rarity}} {{#locked}}kba-achievement-locked{{/locked}}">
                <div class="card-body">
                    <div class="d-flex align-items-start">
                        <div class="kba-achievement-icon mr-3" aria-hidden="true">{{icon}}</div>
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between align-items-start">
                                <h4 class="h5 mb-1">{{name}}</h4>
                                <span class="badge badge-light">{{raritylabel}}</span>
                            </div>
                            <div class="text-muted mb-2">{{{description}}}</div>
                            {{#awarded}}
                                <div class="small font-weight-bold">✓ {{#str}}achievementearned, local_kbagamification{{/str}} — {{date}}</div>
                            {{/awarded}}
                            {{#locked}}
                                <div class="small mb-1">{{current}} / {{target}}</div>
                                <div class="progress" style="height: 8px;">
                                    <div class="progress-bar" role="progressbar" style="width: {{progress}}%;" aria-valuenow="{{progress}}" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            {{/locked}}
                            {{#hasreward}}
                                <div class="small text-muted mt-2">{{#str}}achievementreward, local_kbagamification{{/str}}: +{{rewardxp}} XP / +{{rewardcoins}} {{#str}}coins, local_kbagamification{{/str}}</div>
                            {{/hasreward}}
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {{/achievements}}
    </div>
    {{/hasachievements}}
    {{^hasachievements}}
        <div class="alert alert-light border mb-4">{{#str}}noachievementsconfigured, local_kbagamification{{/str}}</div>
    {{/hasachievements}}

    <h3>{{#str}}recenttransactions, local_kbagamification{{/str}}</h3>
    {{#hastransactions}}
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>{{#str}}date{{/str}}</th>
                    <th>{{#str}}currency, local_kbagamification{{/str}}</th>
                    <th>{{#str}}amount, local_kbagamification{{/str}}</th>
                    <th>{{#str}}reason, local_kbagamification{{/str}}</th>
                    <th>{{#str}}balanceafter, local_kbagamification{{/str}}</th>
                </tr>
            </thead>
            <tbody>
            {{#transactions}}
                <tr>
                    <td>{{date}}</td>
                    <td>{{currency}}</td>
                    <td><strong>{{amount}}</strong></td>
                    <td>{{{reason}}}</td>
                    <td>{{balance}}</td>
                </tr>
            {{/transactions}}
            </tbody>
        </table>
    </div>
    {{/hastransactions}}
    {{^hastransactions}}
        <div class="alert alert-light border">{{#str}}notransactions, local_kbagamification{{/str}}</div>
    {{/hastransactions}}
</div>
