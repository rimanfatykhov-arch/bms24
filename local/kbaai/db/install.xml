      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="assessment_fk" TYPE="foreign" FIELDS="assessmentid" REFTABLE="local_kbaai_assessment" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="local_kbaai_supervisor" COMMENT="Course supervisor AI assistant state">
