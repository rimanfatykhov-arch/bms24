<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/kbaai/db" VERSION="20260816" COMMENT="XMLDB file for local_kbaai"
 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">
  <TABLES>
    <TABLE NAME="local_kbaai_instance" COMMENT="KBA AI settings per KBA Element instance">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="kbaelementid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="enabled" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="mode" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="assistant" SEQUENCE="false"/>
        <FIELD NAME="provider" TYPE="char" LENGTH="32" NOTNULL="true" DEFAULT="mock" SEQUENCE="false"/>
        <FIELD NAME="model" TYPE="char" LENGTH="100" NOTNULL="true" DEFAULT="" SEQUENCE="false"/>
        <FIELD NAME="confidencethreshold" TYPE="int" LENGTH="3" NOTNULL="true" DEFAULT="85" SEQUENCE="false"/>
        <FIELD NAME="autopublish" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="teacherinstructions" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="referenceanswer" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="rubricjson" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="modifiedby" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/></KEYS>
      <INDEXES><INDEX NAME="kbaelement_uix" UNIQUE="true" FIELDS="kbaelementid"/></INDEXES>
    </TABLE>
    <TABLE NAME="local_kbaai_rubric" COMMENT="Visual rubric configuration per KBA Element">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="kbaelementid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="versionno" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="totalscore" TYPE="number" LENGTH="12" DECIMALS="5" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="valid" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="modifiedby" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/></KEYS>
      <INDEXES><INDEX NAME="kbaelement_uix" UNIQUE="true" FIELDS="kbaelementid"/></INDEXES>
    </TABLE>
    <TABLE NAME="local_kbaai_rubric_item" COMMENT="Rubric criteria">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="rubricid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="criterionkey" TYPE="char" LENGTH="32" NOTNULL="true" DEFAULT="" SEQUENCE="false"/>
        <FIELD NAME="sortorder" TYPE="int" LENGTH="6" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="title" TYPE="char" LENGTH="255" NOTNULL="true" DEFAULT="" SEQUENCE="false"/>
        <FIELD NAME="description" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="maxscore" TYPE="number" LENGTH="12" DECIMALS="5" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="required" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="rubric_fk" TYPE="foreign" FIELDS="rubricid" REFTABLE="local_kbaai_rubric" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="rubric_key_uix" UNIQUE="true" FIELDS="rubricid,criterionkey"/>
        <INDEX NAME="rubric_sort_ix" UNIQUE="false" FIELDS="rubricid,sortorder"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_kbaai_rubric_level" COMMENT="Rubric performance levels">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="itemid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="sortorder" TYPE="int" LENGTH="6" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="score" TYPE="number" LENGTH="12" DECIMALS="5" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="label" TYPE="char" LENGTH="255" NOTNULL="true" DEFAULT="" SEQUENCE="false"/>
        <FIELD NAME="description" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="item_fk" TYPE="foreign" FIELDS="itemid" REFTABLE="local_kbaai_rubric_item" REFFIELDS="id"/>
      </KEYS>
      <INDEXES><INDEX NAME="item_sort_ix" UNIQUE="false" FIELDS="itemid,sortorder"/></INDEXES>
    </TABLE>
    <TABLE NAME="local_kbaai_assessment" COMMENT="Immutable AI assessment runs">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="kbaelementid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="submissionid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="targethash" TYPE="char" LENGTH="64" NOTNULL="true" DEFAULT="" SEQUENCE="false"/>
        <FIELD NAME="runno" TYPE="int" LENGTH="6" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="triggername" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="manual" SEQUENCE="false"/>
        <FIELD NAME="mode" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="assistant" SEQUENCE="false"/>
        <FIELD NAME="provider" TYPE="char" LENGTH="32" NOTNULL="true" DEFAULT="mock" SEQUENCE="false"/>
        <FIELD NAME="model" TYPE="char" LENGTH="100" NOTNULL="true" DEFAULT="" SEQUENCE="false"/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="queued" SEQUENCE="false"/>
        <FIELD NAME="reviewstatus" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="none" SEQUENCE="false"/>
        <FIELD NAME="publishstatus" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="hidden" SEQUENCE="false"/>
        <FIELD NAME="gradingsource" TYPE="char" LENGTH="32" NOTNULL="true" DEFAULT="" SEQUENCE="false"/>
        <FIELD NAME="aiscore" TYPE="number" LENGTH="12" DECIMALS="5" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="finalscore" TYPE="number" LENGTH="12" DECIMALS="5" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="maxscore" TYPE="number" LENGTH="12" DECIMALS="5" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="confidence" TYPE="int" LENGTH="3" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="requireshumanreview" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="studentfeedback" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="teachernote" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="resultjson" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="inputsnapshot" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="providerrequestid" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="retrycount" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="lasterror" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="approvedby" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timequeued" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timestarted" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timecompleted" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timeapproved" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timepublished" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/></KEYS>
      <INDEXES>
        <INDEX NAME="submissionhashrun_uix" UNIQUE="true" FIELDS="submissionid,targethash,runno"/>
        <INDEX NAME="elementuser_ix" UNIQUE="false" FIELDS="kbaelementid,userid"/>
        <INDEX NAME="status_ix" UNIQUE="false" FIELDS="status"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_kbaai_audit" COMMENT="KBA AI audit trail">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="assessmentid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="actionname" TYPE="char" LENGTH="40" NOTNULL="true" DEFAULT="" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="detailsjson" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
