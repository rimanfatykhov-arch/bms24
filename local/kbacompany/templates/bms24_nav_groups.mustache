{{#sidebar.groups}}
<details class="bms24-navgroup" {{#expanded}}open{{/expanded}}>
  <summary>{{label}}</summary>
  <nav aria-label="{{label}}">
    {{#items}}
    <a href="{{url}}" class="bms24-navitem{{#active}} is-active{{/active}}" {{#active}}aria-current="page"{{/active}}>
      {{#iconhtml}}<span class="bms24-navicon" aria-hidden="true">{{{iconhtml}}}</span>{{/iconhtml}}
      {{#mobilelabel}}<span class="bms24-navlabel bms24-navlabel-full">{{label}}</span><span class="bms24-navlabel bms24-navlabel-short" aria-hidden="true" data-label="{{mobilelabel}}"></span>{{/mobilelabel}}
      {{^mobilelabel}}<span class="bms24-navlabel">{{label}}</span>{{/mobilelabel}}
      {{#badge}}<span class="bms24-count" title="{{title}}">{{value}}</span>{{/badge}}
    </a>
    {{/items}}
  </nav>
</details>
{{/sidebar.groups}}
{{#sidebar.utilityitems}}
<a href="{{url}}" class="bms24-navitem{{#active}} is-active{{/active}}" {{#active}}aria-current="page"{{/active}}>
  {{#iconhtml}}<span class="bms24-navicon" aria-hidden="true">{{{iconhtml}}}</span>{{/iconhtml}}
  <span class="bms24-navlabel">{{label}}</span>
</a>
{{/sidebar.utilityitems}}
