{{!
    One message bubble (#145): incoming white, outgoing green; reply quote, attachments with name and size,
    actions Reply / Edit / Delete. Edit and delete keep their native forms (sesskey, expected hash). Render-only.
}}
<article class="bms24-comm-msg bms-comm2-message {{#own}}is-own bms-comm3-outgoing{{/own}}{{^own}}bms-comm3-incoming{{/own}}{{#withdrawn}} is-withdrawn{{/withdrawn}}" id="message-{{uuid}}">
<div class="bms24-comm-who bms-comm2-message-meta"><b>{{author}}</b><time class="bms24-comm-tm" title="{{fulltime}}">{{time}}</time>{{#edited}}<span class="bms24-comm-tm">{{edited}}</span>{{/edited}}</div>
{{#quote}}<blockquote class="bms24-comm-quote bms-comm2-quote"><b>{{author}}</b>{{text}}</blockquote>{{/quote}}
<div class="bms24-comm-body bms-comm2-message-body">{{{bodyhtml}}}{{#withdrawntext}}<em>{{withdrawntext}}</em>{{/withdrawntext}}</div>
{{#mentions}}<div class="bms24-comm-mentions bms-comm2-mentions">{{mentions}}</div>{{/mentions}}
{{#hasfiles}}<div class="bms24-comm-files bms-comm2-files">{{#files}}{{#url}}<a class="bms24-comm-file" href="{{url}}" aria-label="{{name}}" title="{{name}}"><span aria-hidden="true">🗎</span><span class="bms24-comm-filenm">{{name}}</span><span class="bms24-comm-filesz">{{size}}</span></a>{{/url}}{{^url}}<span class="bms24-comm-file"><span aria-hidden="true">🗎</span><span class="bms24-comm-filenm">{{name}}</span><span class="bms24-comm-filesz">{{size}}</span></span>{{/url}}{{/files}}</div>{{/hasfiles}}
{{#hasactions}}<div class="bms24-comm-acts bms-comm2-message-actions">{{#actions}}<a href="{{url}}">{{label}}</a>{{/actions}}{{#decision}}<form method="post" class="bms24-comm-inline">{{#hidden}}<input type="hidden" name="{{name}}" value="{{value}}">{{/hidden}}<button type="submit">{{label}}</button></form>{{/decision}}{{#edit}}<details class="bms24-comm-actdetails bms-comm5-edit"><summary>{{editlabel}}</summary><form method="post">{{#edithidden}}<input type="hidden" name="{{name}}" value="{{value}}">{{/edithidden}}<label for="editmsg_{{uuid}}" class="sr-only">{{bodylabel}}</label><textarea id="editmsg_{{uuid}}" name="body" rows="3" required maxlength="20000" class="form-control">{{body}}</textarea><button type="submit" class="bms24-comm-btn bms24-comm-btn--primary">{{savelabel}}</button></form></details><details class="bms24-comm-actdetails bms-comm5-delete"><summary>{{deletelabel}}</summary><form method="post" class="bms24-comm-confirm">{{#deletehidden}}<input type="hidden" name="{{name}}" value="{{value}}">{{/deletehidden}}<p>{{deletenotice}}</p><input type="checkbox" id="deleteconfirm_{{uuid}}" name="confirmwithdraw" value="1" required><label for="deleteconfirm_{{uuid}}">{{confirmlabel}}</label><button type="submit" class="bms24-comm-btn bms24-comm-btn--danger">{{deletelabel}}</button></form></details>{{/edit}}</div>{{/hasactions}}
</article>
