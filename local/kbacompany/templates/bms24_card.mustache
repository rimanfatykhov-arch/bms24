<section class="bms24-card{{#accent}} bms24-card-accent{{/accent}}">
{{#header}}<header class="bms24-cardheader">
{{#eyebrow}}<div class="bms24-eyebrow">{{eyebrow}}</div>{{/eyebrow}}
<div class="bms24-cardheadrow"><div>{{#title}}<h2>{{title}}</h2>{{/title}}{{#subtitle}}<p>{{subtitle}}</p>{{/subtitle}}</div>{{#actionshtml}}<div class="bms24-cardactions">{{{actionshtml}}}</div>{{/actionshtml}}</div>
</header>{{/header}}
<div class="bms24-cardbody">{{{contenthtml}}}</div>
{{#footerhtml}}<footer class="bms24-cardfooter">{{{footerhtml}}}</footer>{{/footerhtml}}
</section>
