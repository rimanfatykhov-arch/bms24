+    public function test_adr0005_migration_preflight_preservation_and_repeat(): void {
+        global $DB, $CFG;
+        $this->resetAfterTest();
+        $this->preventResetByRollback();
+        $this->setAdminUser();
+        require_once($CFG->libdir . '/ddllib.php');
+        require_once($CFG->dirroot . '/local/kbacorporate/db/upgrade.php');
+        $manager = $DB->get_manager();
+        $member = new \xmldb_table('local_kbacorp_member');
+        $plan = new \xmldb_table('local_kbacorp_devplan');
+        $set = static function($table, $name, $type, $size, $default) use ($DB): void {
+            if (!in_array($name, ['isemployee','status'], true) ||
+                    !in_array($default, ['0','1','draft','active','unknown'], true)) {
+                throw new \coding_exception('Unexpected synthetic default');
+            }
+            $DB->change_database_structure(['ALTER TABLE `' . $DB->get_prefix() . $table->getName() . '` ALTER COLUMN `' . $name . '`' .
+                " SET DEFAULT '" . $default . "'"], [$table->getName()]);
+        };
+        $company = repository::save_company((object)['name'=>'Migration', 'active'=>1]);
+        $user = $this->getDataGenerator()->create_user();
+        foreach ([0,1] as $employee) {
+            $other = $this->getDataGenerator()->create_user();
+            $DB->insert_record('local_kbacorp_member', (object)['companyid'=>$company,
+                'userid'=>$other->id, 'membertype'=>'employee', 'isemployee'=>$employee]);
+        }
+        foreach (['draft','active'] as $status) {
+            $DB->insert_record('local_kbacorp_devplan', (object)['companyid'=>$company,
+                'userid'=>$user->id, 'title'=>'Preserved', 'status'=>$status]);
+        }
+        $rows = [$DB->get_records('local_kbacorp_member'), $DB->get_records('local_kbacorp_devplan')];
+        $indexes = [$DB->get_indexes('local_kbacorp_member', false), $DB->get_indexes('local_kbacorp_devplan', false)];
+        try {
+            $set($member, 'isemployee', XMLDB_TYPE_INTEGER, '1', '1');
+            $set($plan, 'status', XMLDB_TYPE_CHAR, '20', 'unknown');
+            try {
+                \local_kbacorporate_adr0005_defaults();
+                $this->fail('Unknown second definition must stop before first ALTER');
+            } catch (\coding_exception $error) {
+                $this->assertStringContainsString('unexpected column definition', $error->getMessage());
+            }
+            $this->assertSame('1', (string)$DB->get_columns('local_kbacorp_member', false)['isemployee']->default_value);
+            $set($plan, 'status', XMLDB_TYPE_CHAR, '20', 'active');
+            for ($repeat=0; $repeat<2; $repeat++) {
+                \local_kbacorporate_adr0005_defaults();
+                $this->assertSame('0', (string)$DB->get_columns('local_kbacorp_member', false)['isemployee']->default_value);
+                $this->assertSame('draft', $DB->get_columns('local_kbacorp_devplan', false)['status']->default_value);
+                $this->assertEquals($rows, [$DB->get_records('local_kbacorp_member'), $DB->get_records('local_kbacorp_devplan')]);
+                $this->assertEquals($indexes, [$DB->get_indexes('local_kbacorp_member', false), $DB->get_indexes('local_kbacorp_devplan', false)]);
+            }
+        } finally {
+            $set($member, 'isemployee', XMLDB_TYPE_INTEGER, '1', '0');
+            $set($plan, 'status', XMLDB_TYPE_CHAR, '20', 'draft');
+        }
+    }
